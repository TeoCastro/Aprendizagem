FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-tk \
    python3-pil \
    python3-pil.imagetk \
    xvfb \
    x11vnc \
    fluxbox \
    novnc \
    websockify \
    && rm -rf /var/lib/apt/lists/*

# Create auto-connect index page for noVNC
RUN printf '<!DOCTYPE html>\n<html>\n<head>\n<meta http-equiv="refresh" content="0; url=vnc.html?autoconnect=true&reconnect=true">\n<title>noVNC</title>\n</head>\n<body>Redirecting to noVNC...</body>\n</html>\n' > /usr/share/novnc/index.html

WORKDIR /app
